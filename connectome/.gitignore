# Raw data — lives OUTSIDE the repo in the shared data root (../data-root,
# override with $DROSOSENSE_DATA). Resolved by connectome/paths.py.
# These rules are defensive: nothing tracked or generated should land here.
raw/
# Large edge metadata CSV (595 MB) — generated by build_olfactory_connectome.py,
# written to the data root's connectome/metadata/. Tracked via sha256 manifest.
metadata/olfactory_v1_edge_meta.csv
# Classified edge metadata CSV with pathway_class/pre_class/post_class columns
metadata/olfactory_v1_edge_meta_classified.csv

# Annotations (small, but derived per-annotation runs)
annotations/
